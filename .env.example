# SuperCompress API key (required for hosted compression)
# https://www.supercompress.dev/dashboard
SUPERCOMPRESS_API_KEY=

# Optional override (default: https://api.supercompress.dev/compress)
# SUPERCOMPRESS_API_URL=https://api.supercompress.dev/compress

# Database (SQLite file — default ./data/openpages.db)
# DATABASE_URL=file:./data/openpages.db
# OPENPAGES_DATA_DIR=./data

# Model providers — any one is enough (called AFTER SuperCompress)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# MCP stdio server
# OPENPAGES_URL=http://127.0.0.1:3000
# OPENPAGES_SPACE_ID=space_demo
