# Optional — the /onboarding wizard also saves credentials to
# ~/.openpages/settings.json (preferred for local OSS installs).

# SuperCompress API key (recommended for hosted compression)
# https://www.supercompress.dev/dashboard
SUPERCOMPRESS_API_KEY=

# Optional override (default: https://api.supercompress.dev/compress)
# SUPERCOMPRESS_API_URL=https://api.supercompress.dev/compress

# Database (SQLite file — default ./data/openpages.db)
# DATABASE_URL=file:./data/openpages.db
# OPENPAGES_DATA_DIR=./data
# OPENPAGES_SETTINGS_PATH=~/.openpages/settings.json

# Model providers — any one is enough (called AFTER SuperCompress).
# Prefer ChatGPT account via onboarding (Codex import / device sign-in)
# if you don't want an OpenAI API key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AI_GATEWAY_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# CODEX_AUTH_PATH=~/.codex/auth.json

# MCP stdio server
# OPENPAGES_URL=http://127.0.0.1:3000
# OPENPAGES_SPACE_ID=space_demo
